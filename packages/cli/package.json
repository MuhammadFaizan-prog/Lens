{
  "name": "@lens/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "lens: one CLI (and lens-mcp, an MCP server) to drive Lens projects from scripts and agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lens": "dist/cli.js",
    "lens-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@lens/engine": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
